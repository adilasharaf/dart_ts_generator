# 1. Generate the directory tree structure, ignoring specific paths
find . -maxdepth 4 -not -path '*/.*' \
  -not -path '*/test/*' -not -path '*/example/*' \
  -not -path '*/bin/*' -not -path '*/node_modules/*' \
  | sed 's/[^/]*\//  /g' > codebase_summary.txt

# 2. Append the header
echo -e "\n--- FILE CONTENTS ---\n" >> codebase_summary.txt

# 3. Find and cat the code files, ignoring the requested paths and locks/readmes
find . -type f \( -name "*.dart" -o -name "*.go" -o -name "*.ts" \) \
  -not -path "*/node_modules/*" \
  -not -path "*/test/*" \
  -not -path "*/example/*" \
  -not -path "*/bin/*" \
  -not -name "*.lock" \
  -not -name "README.md" \
  -exec echo "FILE: {}" \; \
  -exec cat {} \; \
  -exec echo -e "\n--- END FILE ---\n" \; >> codebase_summary.txt